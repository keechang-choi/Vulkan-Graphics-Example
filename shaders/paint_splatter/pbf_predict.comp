#version 450
layout(local_size_x = 256) in;

struct Particle {
  vec4 pos;      // xyz position, w = wetness (M6; <=0 means dried -> removed)
  vec4 vel;      // xyz velocity, w = density ratio (debug)
  vec4 predict;  // xyz predicted x*, w = lambda
  vec4 color;    // rgba paint color
};

// M6-C-2 COMPACTION (M8: compaction ONLY -- integration moved to integrate.comp
// so it can run per-substep). This pass reads the PREVIOUS frame's committed
// state (binding 7, the ping-pong prev buffer), DROPS dried-out particles
// (pos.w <= 0), and packs the survivors to the FRONT of this frame's buffer
// (binding 0, cur) via an atomic counter (binding 9 = liveCount, reset to 0 at
// the top of the frame). emit.comp then appends fresh particles after the
// survivors using the same atomic. All later PBF passes guard on liveCount[0].
// It runs ONCE per frame (its atomic append must not repeat per substep); the
// gravity/predict integration that DOES repeat per substep now lives in
// integrate.comp, the first pass of each substep.
//
// The valid range of the prev buffer is read from binding 10 = prevLiveCount
// (the prev slot's own liveCount, written when it was last `cur` and NOT reset
// this frame). Reading the exact prev count on the GPU -- rather than a host
// value -- keeps compaction correct regardless of readback latency (a host
// count lags the prev buffer by one ping-pong cycle and would re-introduce
// stale slots as ghosts or drop live ones). Mirrors the binding 0/7 ping-pong.
layout(std430, set = 0, binding = 0) buffer Particles { Particle p[]; };
layout(std430, set = 0, binding = 7) readonly buffer ParticlesPrev {
  Particle pprev[];
};
layout(std430, set = 0, binding = 9) buffer LiveCount { uint liveCount[]; };
layout(std430, set = 0, binding = 10) readonly buffer PrevLiveCount {
  uint prevLiveCount[];
};

layout(std140, set = 0, binding = 1) uniform Ubo {
  float dt;
  uint count;
  float gravity;
  float h;
  vec4 cmin;
  vec4 cmax;
  ivec4 gridDim;
  float rho0;
  float epsCFM;
  float scorrK;
  float scorrDq;
  float scorrN;
  float xsphC;
  float kPoly6;
  float kSpiky;
  float scorrDenom;
}
u;

// Must match host kMaxParticles (1 << 16). Keep in sync with paint_splatter.hpp.
const uint kMaxParticles = 65536u;

void main() {
  uint i = gl_GlobalInvocationID.x;
  // Exact GPU guard: only [0, prevLive) of the prev buffer holds valid data.
  uint prevLive = prevLiveCount[0];
  if (i >= prevLive) return;

  Particle src = pprev[i];
  // Drop dried-out particles (absorbed into the canvas) -> they are simply not
  // carried forward, so the live count shrinks. This is the "compaction".
  if (src.pos.w <= 0.0) return;

  // Reserve a packed destination slot at the front of the cur buffer.
  uint d = atomicAdd(liveCount[0], 1u);
  if (d >= kMaxParticles) return;  // pool full (should not happen given bound)

  // Carry committed position / velocity / colour / wetness forward unchanged.
  // No force integration here (M8): integrate.comp applies gravity + predicts x*
  // per substep. predict starts at pos (x* = x) so a guard read before the first
  // integrate is still valid.
  p[d].pos = src.pos;
  p[d].vel = src.vel;
  p[d].predict = vec4(src.pos.xyz, 0.0);
  p[d].color = src.color;
}
