#version 450
layout(local_size_x = 256) in;

struct Particle {
  vec4 pos;
  vec4 vel;
  vec4 predict;
  vec4 color;
};

layout(std430, set = 0, binding = 0) buffer Particles { Particle p[]; };
layout(std140, set = 0, binding = 1) uniform Ubo {
  float dt;
  uint count;
  float gravity;
  float h;
  vec4 cmin;
  vec4 cmax;
  ivec4 gridDim;
  float rho0;
  float epsCFM;
  float scorrK;
  float scorrDq;
  float scorrN;
  float xsphC;
  float kPoly6;
  float kSpiky;
  float scorrDenom;
  float velDamp;
  float velClampFactor;
  float solverRelax;
  uint prevCount;
  float dryRate;
  float depositStrength;
  float depositHeight;
  float depositRadius;
  float drySettle;  // 0..1: how much drying freezes near-floor motion (M6)
  float pad0;
  float pad1;
}
u;
layout(std430, set = 0, binding = 3) buffer CellStart { uint cellStart[]; };
layout(std430, set = 0, binding = 5) buffer SortedIds { uint sortedIds[]; };
layout(std430, set = 0, binding = 9) readonly buffer LiveCount {
  uint liveCount[];
};

ivec3 cellCoord(vec3 x) {
  return clamp(ivec3(floor((x - u.cmin.xyz) / u.h)), ivec3(0), u.gridDim.xyz - 1);
}
float poly6(float r2) {
  if (r2 >= u.h * u.h) return 0.0;
  float t = u.h * u.h - r2;
  return u.kPoly6 * t * t * t;
}

void main() {
  uint i = gl_GlobalInvocationID.x;
  // M6-C-2: the buffer is packed [0, liveCount) with live particles; the host
  // dispatches/draws an UPPER BOUND (>= liveCount). Slots in [liveCount, bound)
  // are stale leftovers from this buffer's previous life -- park them far
  // offscreen so the point-draw clips them and deposit rejects them (uv out of
  // range). Next frame's compaction reads only [0, prevLiveCount) so it never
  // picks these up.
  if (i >= liveCount[0]) {
    p[i].pos = vec4(1e18);
    return;
  }
  vec3 xi = p[i].predict.xyz;
  vec3 vi = (xi - p[i].pos.xyz) / u.dt;
  ivec3 ci = cellCoord(xi);

  vec3 xsph = vec3(0.0);
  float rho = 0.0;
  for (int dz = -1; dz <= 1; dz++)
    for (int dy = -1; dy <= 1; dy++)
      for (int dx = -1; dx <= 1; dx++) {
        ivec3 c = ci + ivec3(dx, dy, dz);
        if (any(lessThan(c, ivec3(0))) ||
            any(greaterThanEqual(c, u.gridDim.xyz)))
          continue;
        uint cell = uint((c.z * u.gridDim.y + c.y) * u.gridDim.x + c.x);
        uint s = cellStart[cell];
        uint e = cellStart[cell + 1u];
        for (uint k = s; k < e; k++) {
          uint j = sortedIds[k];
          vec3 rij = xi - p[j].predict.xyz;
          float r2 = dot(rij, rij);
          if (r2 >= u.h * u.h) continue;
          float w = poly6(r2);
          rho += w;
          if (j != i) xsph += (p[j].vel.xyz - vi) * w;
        }
      }

  // XSPH viscosity (Eq. 17). Normalize by rho0: sum poly6 over neighbors is
  // ~rho0, so dividing makes this a proper density-weighted velocity average.
  vi += u.xsphC * xsph / u.rho0;
  // Global velocity drag: dissipate bulk kinetic energy (XSPH only damps
  // relative velocity) so the fluid can settle into a pool instead of filling
  // the domain ballistically.
  vi *= max(0.0, 1.0 - u.velDamp * u.dt);
  // Optional CFL velocity clamp (velClampFactor<=0 disables it). With enough
  // substeps the velocity recovery v=(x*-x)/dt is already physical, so the
  // clamp is unnecessary; it's kept only as a coarse safety net for large dt.
  if (u.velClampFactor > 0.0) {
    float maxSpeed = u.velClampFactor * u.h / u.dt;
    float sp = length(vi);
    if (sp > maxSpeed) vi *= maxSpeed / sp;
  }
  // Drying settle (M6-C): a near-floor particle freezes in place as it dries
  // (paint setting), instead of sliding/jittering. Scale velocity toward 0 as
  // wetness (pos.w) -> 0. drySettle = 0 disables it, 1 ties motion to wetness.
  if (xi.y >= -u.depositHeight) {
    vi *= mix(1.0, clamp(p[i].pos.w, 0.0, 1.0), u.drySettle);
  }
  p[i].vel.xyz = vi;
  p[i].vel.w = rho / u.rho0;  // density ratio (debug visualization)
  p[i].pos.xyz = xi;
  // Drying (M6): a particle near the floor spends its wetness (pos.w, =1 at
  // emit) while it deposits. When wetness hits 0 it has given up all its paint
  // and is "absorbed" -- removed later by compaction (M6-C-2). deposit.comp
  // stops stamping once pos.w <= 0, so the mark stops darkening (concentration
  // effect: alpha-over accumulates only while wet).
  if (xi.y >= -u.depositHeight && p[i].pos.w > 0.0) {
    p[i].pos.w = max(0.0, p[i].pos.w - u.dryRate * u.dt);
  }
  // Cull off-canvas particles ONCE THEY LAND on the floor (not the instant they
  // cross the edge): a particle that flies off the canvas keeps falling freely
  // (x/z are unclamped, so it is never trapped at a wall) and is removed only
  // when it reaches the ground outside the painting -- where it cannot deposit
  // anyway (UV out of range). pos.w<=0 makes next frame's compaction drop it.(M8)
  if (xi.y >= -u.depositHeight &&
      (abs(xi.x) > u.cmax.x || abs(xi.z) > u.cmax.z)) {
    p[i].pos.w = -1.0;
  }
}
