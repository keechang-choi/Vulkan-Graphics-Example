#version 450
layout(local_size_x = 256) in;

// Emit pass (M5 + M6-C-2): spawn one droplet burst into the particle SSBO.
// Since compaction landed (M6-C-2) the live count is a GPU value (binding 9 =
// liveCount), so each spawned particle reserves its slot with an atomicAdd
// instead of a host-computed baseIndex. This runs AFTER pbf_predict compacts
// the survivors to the front, so new particles append right after them. The
// push-constant `baseIndex` field is kept for layout stability but unused now.

struct Particle {
  vec4 pos;      // xyz position, w = wetness (1 at emit, spent while drying)
  vec4 vel;      // xyz velocity, w = density ratio (debug, set by finalize)
  vec4 predict;  // xyz predicted x*, w = lambda
  vec4 color;    // rgba paint color (a = concentration)
};

layout(std430, set = 0, binding = 0) buffer Particles { Particle p[]; };
layout(std430, set = 0, binding = 9) buffer LiveCount { uint liveCount[]; };

layout(push_constant) uniform Push {
  vec4 originRadius;  // xyz = spoid origin (y<0); w = lattice spacing (mode 0)
                      // OR ball radius = holeRadius (mode 1)
  vec4 velConc;       // xyz = initial velocity (+Y = down on screen), w = conc
  vec4 color;         // rgb = paint color, a unused
  uint mode;          // 0 = jittered cube lattice, 1 = uniform ball (M8)
  uint count;         // number of particles in this burst
  uint seed;          // rng seed (varies per burst)
  uint pad;
}
pc;

// Must match host kMaxParticles (1 << 16). Keep in sync with paint_splatter.hpp.
const uint kMaxParticles = 65536u;

// hash-based RNG (PCG-style integer hash) for per-particle jitter.
uint hash(uint x) {
  x ^= x >> 16;
  x *= 0x7feb352dU;
  x ^= x >> 15;
  x *= 0x846ca68bU;
  x ^= x >> 16;
  return x;
}
float rnd(uint n) {
  return float(hash(n) & 0x00ffffffU) / float(0x01000000);
}

void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= pc.count) return;
  // Reserve a packed slot after the compacted survivors via the shared atomic.
  uint idx = atomicAdd(liveCount[0], 1u);
  if (idx >= kMaxParticles) return;  // pool full -> drop this particle

  uint s = pc.seed + i * 9781u;
  vec3 x;
  if (pc.mode == 1u) {
    // Uniform-in-ball of radius holeRadius (originRadius.w): r = R*cbrt(u) gives
    // a uniform radial density, direction is a uniform point on the sphere.
    // Random placement can land close pairs, but the M8 SOFT constraint
    // (epsCFM~1e5) resolves those gently instead of popping -- which is what
    // made the lattice necessary before. holeRadius now drives droplet size.
    float R = pc.originRadius.w;
    float r = R * pow(rnd(s), 1.0 / 3.0);
    float ct = 2.0 * rnd(s + 1u) - 1.0;            // cos(theta) in [-1,1]
    float st = sqrt(max(0.0, 1.0 - ct * ct));
    float ph = 6.2831853 * rnd(s + 2u);            // azimuth
    vec3 dir = vec3(st * cos(ph), st * sin(ph), ct);
    x = pc.originRadius.xyz + dir * r;
  } else {
    // Jittered cube lattice: place particle i on a regular grid of side
    // ceil(cbrt(count)) at spacing originRadius.w, then add jitter < spacing/2 so
    // a minimum separation is guaranteed (no accidental overlaps -> no spawn pop).
    float spacing = pc.originRadius.w;
    uint side = uint(ceil(pow(float(pc.count), 1.0 / 3.0)));
    if (side < 1u) side = 1u;
    uint ix = i % side;
    uint iy = (i / side) % side;
    uint iz = i / (side * side);
    vec3 grid = (vec3(ix, iy, iz) - 0.5 * (float(side) - 1.0)) * spacing;
    vec3 jit = (vec3(rnd(s), rnd(s + 1u), rnd(s + 2u)) - 0.5) * (0.4 * spacing);
    x = pc.originRadius.xyz + grid + jit;
  }
  p[idx].pos = vec4(x, 1.0);
  p[idx].vel = vec4(pc.velConc.xyz, 1.0);  // w = wetness = 1 (consumed in M6)
  p[idx].predict = vec4(x, 0.0);
  p[idx].color = vec4(pc.color.rgb, pc.velConc.w);  // a = concentration
}
